# Copie este arquivo para .env e preencha.
# A Wikipedia pede que todo programa se identifique e diga como falar com o dono.
# Troque pelo seu contato (um e-mail ou o endereço do seu repositório).
WIKI_USER_AGENT="meu-projeto-de-estudo/0.1 (seu-contato-aqui)"
# Segundos de espera entre uma requisição e a próxima.
WIKI_PAUSA=1
