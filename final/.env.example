# Copie este arquivo para .env e troque o contato pelo seu.
# A Wikipedia pede que todo programa diga quem é e como falar com o dono.
# O contato precisa ser um e-mail ou um endereço de verdade, como o do seu repositório.
WIKI_USER_AGENT="projeto-de-estudo/0.1 (https://github.com/seu-usuario/projeto-wikipedia)"

# O Postgres do projeto roda no Docker (compose.yaml). A senha e o endereço são de treino:
# o banco só existe na sua máquina. Mesmo assim, ficam no .env, fora do Git.
POSTGRES_PASSWORD=treino
DATABASE_URL=postgresql://postgres:treino@localhost:5433/postgres
